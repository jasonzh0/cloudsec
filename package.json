{
  "name": "cloudsec",
  "version": "0.1.1",
  "description": "CLI tool for managing GCP secrets across multiple environments",
  "main": "dist/index.js",
  "bin": {
    "cloudsec": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonzh0/cloudsec.git"
  },
  "homepage": "https://github.com/jasonzh0/cloudsec#readme",
  "bugs": {
    "url": "https://github.com/jasonzh0/cloudsec/issues"
  },
  "author": "Jason Zhang",
  "license": "MIT",
  "keywords": [
    "gcp",
    "secrets",
    "secrets-manager",
    "cli",
    "google-cloud",
    "environment",
    "configuration"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "link": "npm link",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "fs-extra": "^11.4.1",
    "inquirer": "^9.3.8",
    "ora": "^8.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
